{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DokuFoto: Jalankan localhost",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Local:",
          "endsPattern": "Local:.*http://(?:localhost|127\\.0\\.0\\.1):3000"
        }
      },
      "group": "build"
    },
    {
      "label": "DokuFoto: Periksa semua",
      "type": "npm",
      "script": "check",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "DokuFoto: Build produksi",
      "type": "npm",
      "script": "build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
