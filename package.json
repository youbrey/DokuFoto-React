{
  "name": "dokufoto-react",
  "private": true,
  "version": "1.0.0",
  "description": "Aplikasi kolase foto resmi yang berjalan lokal dan offline.",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1 --strictPort",
    "dev:lan": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port=4173 --host=127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
